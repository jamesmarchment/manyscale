<%- include("partials/header", { title: record.fields["Measure Name"] + " | " + locals.siteName }) %>

<body class="portfolio-details-page pt-5">

  <nav class="navbar navbar-expand-xl navbar-light fixed-top py-3" id="mainNav">
    <div class="container px-4 px-lg-5">
<%- include("partials/nav") %>
    </div>
  </nav>


  <main class="main pt-5 mt-5">

    <!-- Page Title -->
    <div class="page-title">
      <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="<%= basePath %>/"><i class="bi bi-house"></i> Home</a></li>
            <li class="breadcrumb-item"><a href="<%= basePath %>/constructs">Constructs and Measures</a></li>
            <li class="breadcrumb-item active current" data-field="Measure Name"></li>
          </ol>
        </nav>
      </div>


    </div><!-- End Page Title -->


    <!-- Portfolio Details Section -->
    <section id="portfolio-details" class="portfolio-details section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="project-intro">
          <div class="intro-content" data-aos="fade-up">
            <!--<div class="project-meta">
              <span class="project-type" id="intro-constructs"></span>
              <span class="project-year" data-field="Year"></span>
            </div>-->
            <h1 class="project-title mb-2" data-field="Measure Name"></h1>
          </div>
        </div>


        <div class="project-details-grid mb-5">
          <div class="row">
            <div class="col-lg-8" data-aos="fade-up" data-aos-delay="100">
              <div class="project-narrative">
                <h5 class="mt-4">Details</h5>
                <p data-field="Description of Measure"></p>
                <!-- sample items -->
                <div id="sample-items-section">
                <h5 class="mt-3">Sample Items</h5>
                <ul>
                <li data-field="Sample Item 1"></li>
                <li data-field="Sample Item 2"></li>
                <li data-field="Sample Item 3"></li>
                </ul>
                </div>
                <!-- end of sample items -->
                <h5 class="mt-3">Download</h5>
                <div id="details_link_buttons"></div>
                
                <div id="translation_link_buttons" class="mb-5"></div>
                <h5>Citation</h5>
                <p data-field="Primary Reference" class="no-break-links"></p>
                <p data-field="Copyright (Required)"><small></small></p>
                <div id="measure-credits" class="measure-credits" style="display:none"></div>

				
              </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
              <div class="project-info mt-3">
                <div class="info-block">
                  <div class="info-label">Year</div>
                  <div class="info-value" data-field="Year"></div>
                </div>
                
                <div class="info-block">
                  <div class="info-label">Construct(s)</div>
                  <div class="info-value" id="sidebar-constructs"></div>
                </div>
                <div class="info-block">
                  <div class="info-label">Number of Dimensions (Subscales)</div>
                  <div class="info-value" data-field="Number of Dimensions (Subscales)"></div>
                </div>
                <div class="info-block">
                  <div class="info-label">Number of Items</div>
                  <div class="info-value" data-field="Number of Items"></div>
                                  <div class="info-block">
                  <div class="info-label">Original Language(s)</div>
                  <div class="info-value" data-field="Language(s)"></div>
                </div>

                </div>
              </div>
            </div>
          </div>
        </div>


<!-- prev/next -->
        <div class="project-navigation" data-aos="fade-up" data-aos-delay="200">
          <div class="nav-container">
            <a href="<%= basePath %>/details/<%= prev.fields['MeasureID'] %>" class="nav-item prev">
              <span class="nav-label">Previous Measure</span>
              <span class="nav-title"><%= prev.fields["Measure Name"] %></span>
            </a>
            <a href="<%= basePath %>/constructs/" class="nav-item center">
              <i class="bi bi-grid"></i>
              <span>All Measures</span>
            </a>
            <a href="<%= basePath %>/details/<%= next.fields['MeasureID'] %>" class="nav-item next">
              <span class="nav-label">Next Measure</span>
              <span class="nav-title"><%= next.fields["Measure Name"] %></span>
            </a>
          </div>
        </div> 

      </div>

    </section><!-- /Portfolio Details Section -->

  </main>



<script>
// testing things
 const recordId = "<%= id %>";

console.log("Record ID:", recordId);


dataToArray(recordId).then(single => {
console.log(single.fields);
  populateFields(single);
  renderLinkButtons(single);

  const constructs = single.fields["Construct(s)"] || [];
  const constructLinks = constructs
    .map(c => `<span class="construct-tag"><a href="<%= basePath %>/constructs/${encodeURIComponent(c)}">${c}</a></span>`)
    .join("");
  // document.getElementById("intro-constructs").innerHTML = constructLinks;
  document.getElementById("sidebar-constructs").innerHTML = constructLinks;
  applyConstructTagColors();


  const translationButtons = document.getElementById("translation_link_buttons");
  const availableTranslations = (single.fields.translations || [])
    .filter(tr => tr["Language"] && tr["Final PDF"]?.[0]?.f_localPath);
  translationButtons.innerHTML = availableTranslations.length ? "<h5>Translations</h5>" : "";
  availableTranslations.forEach(tr => {
    translationButtons.innerHTML += `
      <a href="${tr["Final PDF"][0].f_localPath}" class="view-project" aria-label="Download ${tr["Language"]} translation" target="_blank">
        <button type="button" class="btn-download-translation"><i class="bi bi-translate"></i>${tr["Language"]} Translation</button>
      </a>`;
  });

  const hasSampleItems = ["Sample Item 1", "Sample Item 2", "Sample Item 3"]
    .some(f => single.fields[f]);
  if (!hasSampleItems) {
    document.getElementById("sample-items-section").style.display = "none";
  }

  // Credits block
  const uploadIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/><path d="M7 9l5-5 5 5"/><path d="M12 4v12"/></svg>`;
  const translateIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h12"/><path d="M9 3v2c0 4.4-2.7 8-6 9"/><path d="M5 9c0 2.1 3 4.2 6 5"/><path d="M12 20l4-9 4 9"/><path d="M19.1 18h-6.2"/></svg>`;

  const creditLines = [];

  const submitters = [].concat(single.fields["Name (from Contributed By)"] || []).filter(Boolean);
  if (submitters.length > 0) {
    const names = submitters.map(n => `<strong>${n}</strong>`).join(" and ");
    creditLines.push(`<span>${uploadIcon}Submitted by ${names}</span>`);
  }

  (single.fields.translations || []).forEach(tr => {
    const translators = [].concat(tr["Name (from Contributed By)"] || []).filter(Boolean);
    if (translators.length > 0 && tr["Language"]) {
      const names = translators.map(n => `<strong>${n}</strong>`).join(" and ");
      creditLines.push(`<span>${translateIcon}${tr["Language"]} translation added by ${names}</span>`);
    }
  });

  const creditsEl = document.getElementById("measure-credits");
  if (creditLines.length > 0) {
    creditsEl.innerHTML = creditLines.join("");
    creditsEl.style.display = "";
  }
});
</script>

<%- include("partials/footer") %>