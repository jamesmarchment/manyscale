<%- include("partials/header", {
  title: record.fields["Measure Name"] + " · " + locals.siteName,
  metaDescription: locals.metaDescription,
  metaKeywords: locals.metaKeywords,
}) %>

<body class="portfolio-details-page pt-5">

  <nav class="navbar navbar-expand-xl navbar-light fixed-top py-3" id="mainNav">
    <div class="container px-4 px-lg-5">
<%- include("partials/nav") %>
    </div>
  </nav>


  <main class="main pt-5 mt-5">

    <!-- Page Title -->
    <div class="page-title">
      <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="<%= basePath %>/"><i class="bi bi-house"></i> Home</a></li>
            <li class="breadcrumb-item"><a href="<%= basePath %>/constructs">Constructs and Measures</a></li>
            <li class="breadcrumb-item active current" data-field="Measure Name"></li>
          </ol>
        </nav>
      </div>


    </div><!-- End Page Title -->


    <!-- Portfolio Details Section -->
    <section id="portfolio-details" class="portfolio-details section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="project-intro">
          <div class="intro-content" data-aos="fade-up">
            <!--<div class="project-meta">
              <span class="project-type" id="intro-constructs"></span>
              <span class="project-year" data-field="Year"></span>
            </div>-->
            <h1 class="project-title mb-2" data-field="Measure Name"></h1>
          </div>
        </div>


        <div class="project-details-grid mb-5">
          <div class="row">
            <div class="col-lg-8" data-aos="fade-up" data-aos-delay="100">
              <div class="project-narrative">
                <h5 class="mt-4">Details</h5>
                <p data-field="Description of Measure"></p>
                <!-- sample items -->
                <div id="sample-items-section">
                <h5 class="mt-3">Sample Items</h5>
                <ul>
                <li id="sample-item-1" data-field="Sample Item 1"></li>
                <li id="sample-item-2" data-field="Sample Item 2"></li>
                <li id="sample-item-3" data-field="Sample Item 3"></li>
                </ul>
                </div>
                <!-- end of sample items -->
                <h5 class="mt-3">Download</h5>
                <div id="details_link_buttons"></div>
                
                <div id="translation_link_buttons" class="mb-5"></div>
                <h5>Citation</h5>
                <p data-field="Primary Reference" class="no-break-links"></p>
                <p data-field="Copyright (Required)"><small></small></p>
                <div id="measure-credits" class="measure-credits" style="display:none"></div>

				
              </div>
            </div>
            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
              <div class="project-info mt-3">
                <div class="info-block">
                  <div class="info-label">Year</div>
                  <div class="info-value" data-field="Year"></div>
                </div>
                
                <div class="info-block">
                  <div class="info-label">Construct(s)</div>
                  <div class="info-value" id="sidebar-constructs"></div>
                </div>
                <div class="info-block" id="sidebar-topics-block">
                  <div class="info-label">Topic(s)</div>
                  <div class="info-value" id="sidebar-topics"></div>
                </div>
                <div class="info-block">
                  <div class="info-label">Number of Dimensions (Subscales)</div>
                  <div class="info-value" data-field="Number of Dimensions (Subscales)"></div>
                </div>
                <div class="info-block">
                  <div class="info-label">Number of Items</div>
                  <div class="info-value" data-field="Number of Items"></div>
                </div>
                <div class="info-block">
                  <div class="info-label">Original Language(s)</div>
                  <div class="info-value" data-field="Language(s)"></div>
                </div>
                <div class="info-block" id="report-correction">
                  <div class="info-value" style="text-align: right; font-size: 0.875rem;">
                    <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#reportCorrectionModal" style="color: #aaa;">Report a Correction?</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>


<!-- prev/next -->
        <div class="project-navigation" data-aos="fade-up" data-aos-delay="200">
          <div class="nav-container">
            <a href="<%= basePath %>/details/<%= prev.fields['MeasureID'] %>" class="nav-item prev">
              <span class="nav-label">Previous Measure</span>
              <span class="nav-title"><%= prev.fields["Measure Name"] %></span>
            </a>
            <a href="<%= basePath %>/constructs/" class="nav-item center">
              <i class="bi bi-grid"></i>
              <span>All Measures</span>
            </a>
            <a href="<%= basePath %>/details/<%= next.fields['MeasureID'] %>" class="nav-item next">
              <span class="nav-label">Next Measure</span>
              <span class="nav-title"><%= next.fields["Measure Name"] %></span>
            </a>
          </div>
        </div> 

      </div>

    </section><!-- /Portfolio Details Section -->

  </main>

<!-- Report a Correction Modal -->
<div class="modal fade" id="reportCorrectionModal" tabindex="-1" aria-labelledby="reportCorrectionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reportCorrectionModalLabel">Report a Correction</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="report-correction-form" class="php-email-form">

          <div class="form-trap" aria-hidden="true">
            <label for="report-website">Website</label>
            <input type="text" name="website" id="report-website" tabindex="-1" autocomplete="off">
          </div>
          <input type="hidden" name="_t" id="report-t">

          <div class="form-group">
            <label>Measure</label>
            <input type="text" name="measure_name" value="<%= record.fields['Measure Name'] %>" readonly>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Your Name</label>
                <input type="text" name="name" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" required>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Problem Type</label>
            <select name="problem_type" required>
              <option value="" disabled selected>Select an issue…</option>
              <option>Inaccurate or outdated content</option>
              <option>Broken link or missing file</option>
              <option>Copyright concern / takedown request</option>
              <option>Other</option>
            </select>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="4" required></textarea>
          </div>

          <div class="my-3">
            <div class="loading" style="display:none">Loading</div>
            <div class="error-message"></div>
            <div class="sent-message fade">Thank you! We'll review this and follow up if needed.</div>
          </div>

          <button type="submit" class="submit-btn">
            <span>Submit Report</span>
            <i class="bi bi-arrow-right"></i>
          </button>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
// -- Report a Correction modal ------------------------------------------------
(function () {
  const modal     = document.getElementById("reportCorrectionModal");
  const form      = document.getElementById("report-correction-form");
  if (!modal || !form) return;

  const loadingEl = form.querySelector(".loading");
  const errorEl   = form.querySelector(".error-message");
  const sentEl    = form.querySelector(".sent-message");
  const submitBtn = form.querySelector("button[type='submit']");

  // Stamp the timing token each time the modal opens
  modal.addEventListener("show.bs.modal", () => {
    document.getElementById("report-t").value = Date.now();
  });

  // Reset form state when modal closes. form.reset() restores the read-only Measure
  // field to its server-rendered defaultValue (the current measure's name), not blank —
  // that's intentional, since the field must always show the current measure.
  modal.addEventListener("hidden.bs.modal", () => {
    form.reset();
    errorEl.classList.remove("d-block");
    sentEl.classList.remove("show");
    sentEl.style.display = "";
    submitBtn.style.opacity = "";
    submitBtn.disabled = false;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loadingEl.classList.add("d-block");
    errorEl.classList.remove("d-block");
    sentEl.classList.remove("show");

    const formData = Object.fromEntries(new FormData(form).entries());

    try {
      const response = await fetch("<%= basePath %>/report-correction", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData)
      });
      const result = await response.json();
      loadingEl.classList.remove("d-block");

      if (result.success) {
        submitBtn.style.transition = "opacity 0.5s";
        submitBtn.style.opacity = 0;
        submitBtn.disabled = true;
        sentEl.style.display = "block";
        sentEl.classList.add("show");
        form.reset();
        setTimeout(() => bootstrap.Modal.getInstance(modal).hide(), 2000);
      } else {
        errorEl.textContent = result.error || "Failed to send report.";
        errorEl.classList.add("d-block");
      }
    } catch (err) {
      loadingEl.classList.remove("d-block");
      errorEl.textContent = err.message || "An error occurred.";
      errorEl.classList.add("d-block");
    }
  });
})();
</script>

<script>
// testing things
 const recordId = "<%= id %>";

console.log("Record ID:", recordId);


dataToArray(recordId).then(single => {
console.log(single.fields);
  populateFields(single);
  renderLinkButtons(single);

  const constructs = single.fields["Construct(s)"] || [];
  const constructLinks = constructs
    .map(c => `<span class="construct-tag"><a href="<%= basePath %>/constructs/${encodeURIComponent(c)}">${c}</a></span>`)
    .join("");
  // document.getElementById("intro-constructs").innerHTML = constructLinks;
  document.getElementById("sidebar-constructs").innerHTML = constructLinks;

  // Topic(s) is a separate, independent tag taxonomy from Construct(s) — absent
  // entirely (not just empty) for tenants whose Airtable base has no Topic(s) column
  // (e.g. AggreScale), which behaves identically to a record that has the column but no
  // value set: single.fields["Topic(s)"] is simply undefined either way.
  const topics = single.fields["Topic(s)"] || [];
  const topicsBlock = document.getElementById("sidebar-topics-block");
  if (topics.length > 0) {
    topicsBlock.style.display = "";
    document.getElementById("sidebar-topics").innerHTML = topics
      .map(t => `<span class="construct-tag"><a href="<%= basePath %>/topics/${encodeURIComponent(t)}">${t}</a></span>`)
      .join("");
  } else {
    topicsBlock.style.display = "none";
  }

  applyConstructTagColors();


  const translationButtons = document.getElementById("translation_link_buttons");
  const availableTranslations = (single.fields.translations || [])
    .filter(tr => tr["Language"] && tr["Final PDF"]?.[0]?.f_localPath);
  translationButtons.innerHTML = availableTranslations.length ? "<h5>Translations</h5><br>" : "";
  availableTranslations.forEach(tr => {
    translationButtons.innerHTML += `
      <a href="${tr["Final PDF"][0].f_localPath}" class="view-project" aria-label="Download ${tr["Language"]} translation" target="_blank">
        <button type="button" class="btn-download-translation"><i class="bi bi-translate"></i>${tr["Language"]} Adaptation</button>
      </a>`;
  });

  const sampleItemFields = ["Sample Item 1", "Sample Item 2", "Sample Item 3"];
  let hasSampleItems = false;
  sampleItemFields.forEach((f, i) => {
    const li = document.getElementById(`sample-item-${i + 1}`);
    if (single.fields[f]) {
      hasSampleItems = true;
    } else {
      li.style.display = "none";
    }
  });
  if (!hasSampleItems) {
    document.getElementById("sample-items-section").style.display = "none";
  }

  // Credits block
  const uploadIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/><path d="M7 9l5-5 5 5"/><path d="M12 4v12"/></svg>`;
  const translateIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h12"/><path d="M9 3v2c0 4.4-2.7 8-6 9"/><path d="M5 9c0 2.1 3 4.2 6 5"/><path d="M12 20l4-9 4 9"/><path d="M19.1 18h-6.2"/></svg>`;

  const creditLines = [];

  const submitters = [].concat(single.fields["Name (from Contributed By)"] || []).filter(Boolean);
  if (submitters.length > 0) {
    const names = submitters.map(n => `<strong>${n}</strong>`).join(" and ");
    creditLines.push(`<span>${uploadIcon}Submitted by ${names}</span>`);
  }

  (single.fields.translations || []).forEach(tr => {
    const translators = [].concat(tr["Name (from Contributed By)"] || []).filter(Boolean);
    if (translators.length > 0 && tr["Language"]) {
      const names = translators.map(n => `<strong>${n}</strong>`).join(" and ");
      creditLines.push(`<span>${translateIcon}${tr["Language"]} adaptation added by ${names}</span>`);
    }
  });

  const creditsEl = document.getElementById("measure-credits");
  if (creditLines.length > 0) {
    creditsEl.innerHTML = creditLines.join("");
    creditsEl.style.display = "";
  }
});
</script>

<%- include("partials/footer") %>