    <section class="admin-section" id="configuration">
      <h2>Configuration</h2>
      <div class="card">
        <div class="actions" style="border-top: none; border-bottom: 1px solid #f1f1f1;">
          <label style="display: flex; align-items: center; gap: .5rem; cursor: pointer; font-size: .875rem; color: #52525b;">
            <input type="checkbox" id="cfg-unlock" style="width: auto; margin: 0;">
            Unlock to enable editing
          </label>
        </div>
        <form method="POST" action="<%= basePath %>/admin/config" id="cfg-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <table>
            <tr>
              <th><label for="cfg-name">Name</label></th>
              <td><input type="text" id="cfg-name" name="name" value="<%= tenant.name || '' %>" disabled></td>
            </tr>
            <tr>
              <th><label for="cfg-contact_recipient">Email</label></th>
              <td><input type="text" id="cfg-contact_recipient" name="contact_recipient" value="<%= tenant.contact_recipient || '' %>" disabled></td>
            </tr>
            <tr>
              <th><label for="cfg-base">Base ID</label></th>
              <td><input type="text" id="cfg-base" name="baseId" value="<%= tenant.baseId || '' %>" disabled></td>
            </tr>
            <tr>
              <th><label for="cfg-pat">PAT</label></th>
              <td>
                <input type="password" id="cfg-pat" name="pat" placeholder="Leave blank to keep current" autocomplete="new-password" disabled>
                <p class="hint">Stored in <code>.env</code> under <code><%= tenant.patEnvVar || "AIRTABLE_PAT" %></code>. Changes take effect after a server restart.</p>
              </td>
            </tr>
          </table>
          <div class="actions">
            <button type="submit" class="btn" id="cfg-submit" disabled>Save Configuration</button>
            <span class="muted">Base ID and PAT changes require a server restart.</span>
          </div>
        </form>
      </div>
    </section>
    <script>
      document.getElementById('cfg-unlock').addEventListener('change', function () {
        const locked = !this.checked;
        document.querySelectorAll('#cfg-form input').forEach(el => el.disabled = locked);
        document.getElementById('cfg-submit').disabled = locked;
      });

    </script>
    <script>
      (function () {
        function initHexPicker(hiddenId, hexInputId, pickrSelector, fallback, onUpdate) {
          const hidden   = document.getElementById(hiddenId);
          const hexInput = document.getElementById(hexInputId);

          const pickr = Pickr.create({
            el: pickrSelector,
            theme: 'nano',
            default: hidden.value || fallback,
            comparison: false,
            components: {
              preview: true,
              opacity: false,
              hue: true,
              interaction: { hex: true, input: true }
            }
          });

          pickr.on('change', (color) => {
            const hex = color.toHEXA().toString().substring(0, 7).toLowerCase();
            hidden.value   = hex;
            hexInput.value = hex;
            if (onUpdate) onUpdate(hex);
          });

          hexInput.addEventListener('input', () => {
            const v = hexInput.value.trim();
            if (/^#[0-9a-f]{6}$/i.test(v)) {
              hidden.value = v;
              pickr.setColor(v);
              if (onUpdate) onUpdate(v);
            }
          });
          hexInput.addEventListener('blur', () => { hexInput.value = hidden.value; });
        }

        initHexPicker('logo-color', 'logo-color-hex', '#logo-color-pickr', '#000000');
        initHexPicker('landing-header-color', 'landing-header-color-hex', '#landing-header-color-pickr', '#f5e642', (hex) => {
          const el = document.getElementById('card-preview');
          if (el) el.style.setProperty('--header-color', hex);
        });
        initHexPicker('landing-accent-color', 'landing-accent-color-hex', '#landing-accent-color-pickr', '#e8180a', (hex) => {
          const el = document.getElementById('card-preview-bio');
          if (el) el.style.borderLeftColor = hex;
        });
      })();
    </script>

    <script>
      // Homepage Hero preview: live text mirroring + a decorative (non-data-driven)
      // bubble cluster colored from the tenant's current bubbleChartColors.
      (function () {
        // Pre-computed circle-pack layout (rejection-sampled so none of these overlap —
        // largest to smallest, each new circle rejected against every already-placed one
        // until it clears a small gap). size/left/top are all percentages of the
        // container: size is diameter as % of container width (paired with
        // aspect-ratio:1 on .hero-bubble so height always matches), left/top are the
        // circle's top-left corner as % of container width/height respectively — NOT
        // percentages of a 12-item index, so this scales cleanly at any container size,
        // unlike the earlier px-based layout that only worked at the width it was tuned for.
        const BUBBLE_LAYOUT = [
          { size: 34, left: 33.0, top: 32.6 },
          { size: 28, left: 34.9, top: 69.6 },
          { size: 24, left: 9.5,  top: 52.3 },
          { size: 21, left: 69.9, top: 42.4 },
          { size: 18, left: 18.4, top: 22.2 },
          { size: 16, left: 62.7, top: 22.7 },
          { size: 14, left: 42.4, top: 15.6 },
          { size: 13, left: 63.4, top: 65.6 },
          { size: 12, left: 8.0,  top: 37.8 },
          { size: 11, left: 56.4, top: 7.9  },
          { size: 10, left: 31.3, top: 10.2 },
          { size: 9,  left: 82.1, top: 30.9 },
        ];

        function renderBubbles(colors) {
          const container = document.getElementById('hero-preview-bubbles');
          if (!container) return;
          const palette = (colors && colors.length) ? colors : ['#ccc'];
          container.innerHTML = BUBBLE_LAYOUT.map((b, i) => {
            const color = palette[i % palette.length];
            return `<div class="hero-bubble" style="width:${b.size}%;left:${b.left}%;top:${b.top}%;background:${color}"></div>`;
          }).join('');
        }

        window.updateHeroBubblePreview = renderBubbles;

        let initialColors = [];
        try {
          const currentColorsEl = document.getElementById('current-colors-json');
          if (currentColorsEl) initialColors = JSON.parse(currentColorsEl.textContent).bubbleChartColors || [];
        } catch {}
        renderBubbles(initialColors);

        const headingInput = document.getElementById('hero-heading');
        const subInput = document.getElementById('hero-sub');
        const headingPreview = document.getElementById('hero-preview-heading');
        const subPreview = document.getElementById('hero-preview-sub');
        if (headingInput && headingPreview) headingInput.addEventListener('input', (e) => { headingPreview.textContent = e.target.value; });
        if (subInput && subPreview) subInput.addEventListener('input', (e) => { subPreview.textContent = e.target.value; });
      })();
    </script>

    <script>
      // Landing Page Card preview: live tagline text (colors are wired from the
      // Colors-section initHexPicker() calls above).
      (function () {
        const taglineInput = document.getElementById('landing-tagline');
        const taglinePreview = document.getElementById('card-preview-tagline');
        if (taglineInput && taglinePreview) {
          taglineInput.addEventListener('input', (e) => { taglinePreview.textContent = e.target.value; });
        }
      })();
    </script>

    <script>
      // Social-share-card preview: mirrors the real og:title/og:description fallback
      // formulas from views/partials/header.ejs.
      (function () {
        const tenantName = <%- JSON.stringify(tenant.name || '') %>;
        const savedDescription = <%- JSON.stringify(locals.siteDescription || '') %>;
        const titleEl = document.getElementById('social-preview-title');
        const descEl = document.getElementById('social-preview-desc');
        const tagInput = document.getElementById('meta-tagline');
        const descInput = document.getElementById('meta-desc');
        if (tagInput && titleEl) {
          tagInput.addEventListener('input', (e) => {
            const tag = e.target.value.trim();
            titleEl.textContent = tenantName + (tag ? ' · ' + tag : '');
          });
        }
        if (descInput && descEl) {
          descInput.addEventListener('input', (e) => {
            descEl.textContent = e.target.value.trim() || savedDescription;
          });
        }
      })();
    </script>

    <script>
      // Sidebar scroll-spy: highlights the nav link for whichever .admin-section is
      // currently crossing a thin band near vertical-center of the viewport.
      (function () {
        const sections = Array.from(document.querySelectorAll('.admin-section'));
        const links = Array.from(document.querySelectorAll('.sidebar-nav .nav-link'));
        const linkFor = (id) => links.find(a => a.getAttribute('href') === '#' + id);

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            links.forEach(a => a.classList.remove('active'));
            const active = linkFor(entry.target.id);
            if (active) active.classList.add('active');
          });
        }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

        sections.forEach(s => observer.observe(s));
      })();
    </script>

    </main>
  </div>
</body>
</html>
