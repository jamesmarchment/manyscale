<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot Password</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: #f4f4f5; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .card { background: #fff; border: 1px solid #e4e4e7; border-radius: 6px; padding: 2rem; width: 100%; max-width: 360px; }
    h1 { font-size: 1.2rem; margin: 0 0 1rem; }
    p.hint { font-size: .85rem; color: #52525b; margin: 0 0 1.5rem; line-height: 1.5; }
    button { width: 100%; padding: .55rem; background: #18181b; color: #fff; border: none; border-radius: 4px; font-size: .95rem; cursor: pointer; }
    button:hover { background: #3f3f46; }
    .error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 4px; padding: .5rem .75rem; font-size: .85rem; margin-bottom: 1rem; }
    .ok { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; border-radius: 4px; padding: .5rem .75rem; font-size: .85rem; margin-bottom: 1rem; }
    a.back { display: block; text-align: center; margin-top: 1rem; font-size: .85rem; color: #52525b; text-decoration: none; }
    a.back:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Forgot your password?</h1>
    <% if (locals.error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <% if (sent) { %>
      <div class="ok">Check your email — we've sent a reset link to <%= maskedEmail %>. It expires in 60 minutes.</div>
    <% } else { %>
      <p class="hint">We'll email a password reset link to <%= maskedEmail %>.</p>
      <form method="POST" action="<%= basePath %>/admin/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Send reset link</button>
      </form>
    <% } %>
    <a class="back" href="<%= basePath %>/admin/login">Back to login</a>
  </div>
</body>
</html>
