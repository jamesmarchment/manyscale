
<!DOCTYPE html>
<html lang="en">

<head>
<base href="/">
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title><%= locals.title || (locals.siteName + (locals.siteTagline ? ' · ' + locals.siteTagline : '')) %></title>
  <!-- metaDescription/metaKeywords let a specific page (e.g. views/details.ejs, via
       lib/seo.js) override the generic tenant-wide description/empty keywords below
       with something unique to that page — search engines penalize identical
       descriptions repeated across many pages. -->
  <meta name="description" content="<%= locals.metaDescription || locals.siteDescription %>">
  <meta name="keywords" content="<%= locals.metaKeywords || '' %>">
  <link rel="canonical" href="<%= locals.canonicalUrl %>">

  <!-- Plausible Analytics — configured in Architect Admin under Platform Settings.
       All tenants share one path-based domain, so data-domain is deployment-wide,
       not per-tenant. Omitted entirely when no domain is set. Script + event calls
       are proxied through this app's own origin (lib/analyticsProxy.js) rather than
       pointed straight at the analytics.* subdomain, since ad blockers and
       tracking-protection lists block that hostname pattern outright — data-api
       overrides the script's default same-origin "/api/event" endpoint so it lands
       on our proxy route instead of reserving the generic "/api" path. -->
  <% if (process.env.PLAUSIBLE_DOMAIN) { %>
  <script defer data-domain="<%= process.env.PLAUSIBLE_DOMAIN %>" data-api="/analytics/event" src="/analytics/js"></script>
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= locals.siteName %>">
  <meta property="og:title" content="<%= locals.title || (locals.siteName + (locals.siteTagline ? ' · ' + locals.siteTagline : '')) %>">
  <meta property="og:description" content="<%= locals.metaDescription || locals.siteDescription %>">
  <meta property="og:url" content="<%= locals.canonicalUrl || 'https://manyscale.org' %>">
  <meta property="og:image" content="<%= (locals.siteOrigin || 'https://manyscale.org') + (locals.metaImagePath || '/assets/img/manyscale_meta.jpg') %>">
  <meta property="og:image:alt" content="<%= locals.siteName || 'ManyScale' %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= locals.title || (locals.siteName + (locals.siteTagline ? ' · ' + locals.siteTagline : '')) %>">
  <meta name="twitter:description" content="<%= locals.metaDescription || locals.siteDescription %>">
  <meta name="twitter:image" content="<%= (locals.siteOrigin || 'https://manyscale.org') + (locals.metaImagePath || '/assets/img/manyscale_meta.jpg') %>">

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon">
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css?family=Merriweather+Sans:400,700" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="/assets/css/styles.css" rel="stylesheet">
  <link href="/assets/css/manyscale.css" rel="stylesheet">

  <!-- Tenant base path, for static JS (manyscale.js/index.js) that can't use EJS locals directly -->
  <script>window.BASE_PATH = "<%= locals.basePath || '' %>";</script>
  <script type="application/json" id="tenant-colors-json"><%- JSON.stringify({ bubbleChart: locals.bubbleChartColors || [], cardGradients: locals.cardGradients || [], tagColors: locals.tagColors || [], tagColorsPreset: locals.tagColorsPreset || "default", tagRecipe: locals.tagRecipe || "pastel" }).replace(/<\//g, '<\\/') %></script>
  <script>window.TENANT_COLORS = JSON.parse(document.getElementById('tenant-colors-json').textContent);</script>
  <script src="/assets/js/manyscale.js"></script>
</head>

