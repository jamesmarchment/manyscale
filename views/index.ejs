<script>
(function () {
  const input = document.getElementById("index-search-input");
  const list  = document.getElementById("index-suggestions-list");
  const form  = document.getElementById("index-search-form");
  let activeIndex = -1;
  let debounceTimer = null;

  function escapeHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  const stopWords = new Set(['a','an','the','and','or','of','in','to','for','with','on','at','by','from']);

  function renderSuggestions(suggestions, query) {
    list.innerHTML = "";
    activeIndex = -1;
    if (!suggestions.length) { list.style.display = "none"; return; }
    const lower = query.toLowerCase();
    suggestions.forEach(function (s) {
      const li = document.createElement("li");
      li.style.cssText = "padding:8px 16px; cursor:pointer; font-size:0.95rem;";
      // Find the first non-stop-word that starts with the query and bold its prefix
      const wordRe = /\w+/g;
      let m, pos = -1;
      while ((m = wordRe.exec(s)) !== null) {
        if (m[0].toLowerCase().startsWith(lower) && !stopWords.has(m[0].toLowerCase())) {
          pos = m.index; break;
        }
      }
      li.innerHTML = pos >= 0
        ? escapeHtml(s.slice(0, pos)) + "<strong>" + escapeHtml(s.slice(pos, pos + query.length)) + "</strong>" + escapeHtml(s.slice(pos + query.length))
        : escapeHtml(s);
      li.addEventListener("mousedown", function (e) {
        e.preventDefault();
        input.value = s;
        list.style.display = "none";
        form.submit();
      });
      li.addEventListener("mouseenter", function () {
        setActive(Array.from(list.children).indexOf(li));
      });
      list.appendChild(li);
    });
    list.style.display = "block";
  }

  function setActive(index) {
    const items = list.children;
    if (activeIndex >= 0 && items[activeIndex]) items[activeIndex].style.background = "";
    activeIndex = index;
    if (activeIndex >= 0 && items[activeIndex]) items[activeIndex].style.background = "#f0f0f0";
  }

  function fetchSuggestions(query) {
    if (query.length < 3) { list.style.display = "none"; return; }
    fetch("<%= basePath %>/search/suggestions?query=" + encodeURIComponent(query))
      .then(function (r) { return r.json(); })
      .then(function (data) { renderSuggestions(data.suggestions, query); })
      .catch(function () { list.style.display = "none"; });
  }

  input.addEventListener("input", function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () { fetchSuggestions(input.value.trim()); }, 180);
  });

  input.addEventListener("keydown", function (e) {
    const items = list.children;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(Math.min(activeIndex + 1, items.length - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(Math.max(activeIndex - 1, -1));
    } else if (e.key === "Enter") {
      if (activeIndex >= 0 && items[activeIndex]) {
        e.preventDefault();
        input.value = items[activeIndex].textContent;
        list.style.display = "none";
        form.submit();
      }
    } else if (e.key === "Escape") {
      list.style.display = "none";
      activeIndex = -1;
    }
  });

  document.addEventListener("click", function (e) {
    if (!form.contains(e.target)) { list.style.display = "none"; activeIndex = -1; }
  });
})();
</script>

<script>
// -- Footnote highlight (prevent scroll, flash the target instead) ----------
document.querySelectorAll('a[href^="#fn-"]').forEach(link => {
  link.addEventListener("click", e => {
    e.preventDefault();
    const target = document.getElementById(link.getAttribute("href").slice(1));
    if (!target) return;
    target.classList.remove("fn-highlight");
    void target.offsetWidth; // force reflow so animation restarts on repeated clicks
    target.classList.add("fn-highlight");
  });
});
</script>

