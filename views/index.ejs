            <label for="suggest-website">Website</label>
            <input type="text" name="website" id="suggest-website" tabindex="-1" autocomplete="off">
          </div>
          <input type="hidden" name="_t" id="suggest-t">

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label>Your Name</label>
                <input type="text" name="name" required>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" required>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Measure Name</label>
            <input type="text" name="measure_name" required>
          </div>

          <div class="form-group">
            <label>Citation</label>
            <input type="text" name="citation" required placeholder="Author(s), Year, Journal…">
          </div>

          <div class="form-group">
            <label>Comments <span class="text-muted" style="font-weight:400;font-size:0.85em">(optional)</span></label>
            <textarea name="comments" rows="3"></textarea>
          </div>

          <div class="my-3">
            <div class="loading" style="display:none">Loading</div>
            <div class="error-message"></div>
            <div class="sent-message fade">Thank you! We'll look into adding this measure.</div>
          </div>

          <button type="submit" class="submit-btn">
            <span>Submit Suggestion</span>
            <i class="bi bi-arrow-right"></i>
          </button>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
// -- Suggest a Measure modal ------------------------------------------------
(function () {
  const modal     = document.getElementById("suggestModal");
  const form      = document.getElementById("suggest-form");
  if (!modal || !form) return;

  const loadingEl = form.querySelector(".loading");
  const errorEl   = form.querySelector(".error-message");
  const sentEl    = form.querySelector(".sent-message");
  const submitBtn = form.querySelector("button[type='submit']");

  // Stamp the timing token each time the modal opens
  modal.addEventListener("show.bs.modal", () => {
    document.getElementById("suggest-t").value = Date.now();
  });

  // Reset form state when modal closes
  modal.addEventListener("hidden.bs.modal", () => {
    form.reset();
    errorEl.classList.remove("d-block");
    sentEl.classList.remove("show");
    sentEl.style.display = "";
    submitBtn.style.opacity = "";
    submitBtn.disabled = false;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    loadingEl.classList.add("d-block");
    errorEl.classList.remove("d-block");
    sentEl.classList.remove("show");

    const formData = Object.fromEntries(new FormData(form).entries());

    try {
      const response = await fetch("<%= basePath %>/suggest", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData)
      });
      const result = await response.json();
      loadingEl.classList.remove("d-block");

      if (result.success) {
        submitBtn.style.transition = "opacity 0.5s";
        submitBtn.style.opacity = 0;
        submitBtn.disabled = true;
        sentEl.style.display = "block";
        sentEl.classList.add("show");
        form.reset();
        setTimeout(() => bootstrap.Modal.getInstance(modal).hide(), 2000);
      } else {
        errorEl.textContent = result.error || "Failed to send suggestion.";
        errorEl.classList.add("d-block");
      }
    } catch (err) {
      loadingEl.classList.remove("d-block");
      errorEl.textContent = err.message || "An error occurred.";
      errorEl.classList.add("d-block");
    }
  });
})();
</script>

