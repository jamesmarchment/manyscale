<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tenant Created — Master Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background: #f4f4f5; margin: 0; padding: 1.5rem; color: #18181b; }
    .wrap { max-width: 680px; margin: 0 auto; }
    header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.5rem; }
    header h1 { font-size: 1.2rem; margin: 0; }
    h2 { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #71717a; margin: 1.5rem 0 .5rem; }
    .card { background: #fff; border: 1px solid #e4e4e7; border-radius: 6px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; }
    tr + tr td, tr + tr th { border-top: 1px solid #f1f1f1; }
    th, td { padding: .55rem .85rem; text-align: left; font-size: .9rem; vertical-align: top; }
    th { width: 38%; color: #52525b; font-weight: 500; }
    code { font-family: monospace; font-size: .85em; background: #f4f4f5; padding: .1em .3em; border-radius: 3px; }
    .btn { padding: .4rem .9rem; background: #18181b; color: #fff; border: none; border-radius: 4px; font-size: .85rem; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn:hover { background: #3f3f46; }
    .btn-ghost { background: transparent; color: #52525b; border: 1px solid #d4d4d8; }
    .btn-ghost:hover { background: #f4f4f5; }
    .banner { border-radius: 4px; padding: .75rem .85rem; font-size: .9rem; margin-bottom: 1.5rem; }
    .banner.ok  { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
    .banner.warn { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .muted { color: #71717a; font-size: .85rem; }
    .actions { padding: .75rem .85rem; background: #fafafa; border-top: 1px solid #f1f1f1; }
    .scaffold-list { margin: 0; padding-left: 1.1rem; font-size: .85rem; }
    .scaffold-list li.error { color: #b91c1c; }
  </style>
</head>
<body>
  <div class="wrap">

    <header>
      <h1>Tenant Created</h1>
    </header>

    <div class="banner ok">
      Tenant "<%= tenant.name %>" was created successfully.
    </div>

    <% if (!airtableSyncOk) { %>
      <div class="banner warn">
        Initial Airtable sync did not complete — check the Base ID and PAT, then refresh the cache from the dashboard once fixed. The tenant was still created.
      </div>
    <% } %>

    <h2>Tenant Details</h2>
    <div class="card">
      <table>
        <tr><th>Name</th><td><%= tenant.name %></td></tr>
        <tr><th>Slug</th><td><code><%= tenant.slug %></code></td></tr>
        <tr><th>Contact Email</th><td><%= tenant.contact_recipient %></td></tr>
        <tr><th>Base ID</th><td><code><%= tenant.baseId %></code></td></tr>
        <tr><th>Admin Panel</th>
          <td>
            <% if (adminUrl) { %>
              <a href="<%= adminUrl %>"><%= adminUrl %></a>
            <% } else { %>
              <span class="muted"><%= multiTenantNote %></span>
            <% } %>
          </td>
        </tr>
      </table>
    </div>

    <% if (locals.scaffoldResult) { %>
      <h2>Table Scaffolding</h2>
      <div class="card">
        <table>
          <tr>
            <th>Created</th>
            <td><%= scaffoldResult.created.length ? scaffoldResult.created.join(", ") : "—" %></td>
          </tr>
          <tr>
            <th>Already present</th>
            <td><%= scaffoldResult.skipped.length ? scaffoldResult.skipped.join(", ") : "—" %></td>
          </tr>
          <% if (scaffoldResult.errors.length) { %>
            <tr>
              <th>Errors</th>
              <td>
                <ul class="scaffold-list">
                  <% scaffoldResult.errors.forEach(e => { %>
                    <li class="error"><%= e.table || "General" %>: <%= e.message %></li>
                  <% }) %>
                </ul>
              </td>
            </tr>
          <% } %>
        </table>
      </div>
    <% } %>

    <div class="card" style="margin-top:1.5rem">
      <div class="actions">
        <a href="/master" class="btn">Back to Dashboard</a>
      </div>
    </div>

  </div>
</body>
</html>
