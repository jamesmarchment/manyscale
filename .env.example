# Airtable
# Primary PAT: the variable name is set per-tenant in tenants.json under "patEnvVar"
# (e.g. if patEnvVar is "RELASCALE_PAT", add that key here)
RELASCALE_PAT={your Airtable personal access token}

# Optional secondary source: add one entry per tenant that needs it, using the
# variable names specified in tenants.json under "secondaryPatEnvVar" / "secondaryBaseId"
# YOUR_SECONDARY_PAT_ENV_VAR={patXXXXXXXXXXXXXX}

# Email (SMTP)
SMTP_USER={email address used to send contact and suggestion form emails}
SMTP_PASS={SMTP password for SMTP_USER}

# Admin
# ADMIN_PASSWORD is now set per-tenant in tenants.json under "adminPassword"
ADMIN_TOKEN={token for /admin/refresh-cache and /admin/sync-pdfs endpoints}

# Session
SESSION_SECRET={long random string used to sign session cookies}

# Server
PORT={port to listen on — defaults to 3007}
MULTI_TENANT={set to "true" to enable slug-prefixed URLs, e.g. /relationships/constructs — omit or set to "false" for single-tenant mode}
